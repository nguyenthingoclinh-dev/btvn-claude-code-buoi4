+def save_platform_cookies(platform: str, cookies: list, uploaded_by: str = ""):
+    """Lưu cookies platform vào Firestore. platform = 'topcv'|'jobsgo'|'vnw'..."""
+    _get_db().collection("platform_cookies").document(platform).set({
+        "platform": platform,
+        "cookies": cookies,
+        "uploaded_by": uploaded_by,
+        "uploaded_at": datetime.now().strftime("%d/%m/%Y %H:%M"),
+        "cookie_count": len(cookies),
+        "updated_at": firestore.SERVER_TIMESTAMP,
+    })
+    log.info("Saved %d cookies for %s", len(cookies), platform)
+
+
+def get_platform_cookies(platform: str) -> dict | None:
+    doc = _get_db().collection("platform_cookies").document(platform).get()
+    if not doc.exists:
+        return None
+    return doc.to_dict()
+
+
+def list_platform_cookies() -> list[dict]:
+    """List tất cả platform có cookies. Trả về metadata, không trả raw cookies."""
+    docs = _get_db().collection("platform_cookies").stream()
+    out = []
+    for d in docs:
+        data = d.to_dict() or {}
+        out.append({
+            "platform": d.id,
+            "uploaded_by": data.get("uploaded_by", ""),
+            "uploaded_at": data.get("uploaded_at", ""),
+            "cookie_count": data.get("cookie_count", 0),
+        })
+    return out
+
