+async function submitAddCv() {
+  const name = document.getElementById('cvName').value.trim();
+  const email = document.getElementById('cvEmail').value.trim();
+  const sdt = document.getElementById('cvSdt').value.trim();
+  const position = document.getElementById('cvPosition').value;
+  const nguon = document.getElementById('cvNguon').value;
+  const file = document.getElementById('cvFile').files[0];
+  if (!name) { showToast('⚠️ Nhập họ tên'); return; }
+  if (!email) { showToast('⚠️ Nhập email'); return; }
+  if (!position) { showToast('⚠️ Chọn vị trí ứng tuyển'); return; }
+  if (!file) { showToast('⚠️ Chọn file CV PDF'); return; }
+  if (file.size > 20*1024*1024) { showToast('⚠️ File > 20MB'); return; }
+  if (!/\.pdf$/i.test(file.name)) { showToast('⚠️ Chỉ chấp nhận file PDF'); return; }
+
+  const btn = document.getElementById('cvSubmitBtn');
+  btn.disabled = true;
+  btn.textContent = '⏳ Đang upload + AI extract...';
+  showToast('⏳ Đang xử lý CV qua AI...');
+
+  try {
+    const buf = await file.arrayBuffer();
+    const bytes = new Uint8Array(buf);
+    let bin = '';
+    for (let i=0;i<bytes.length;i+=0x8000) bin += String.fromCharCode.apply(null, bytes.subarray(i,i+0x8000));
+    const b64 = btoa(bin);
+
+    // Generate email_id unique
+    const emailIdSafe = `manual_${email.replace(/[^a-zA-Z0-9]/g,'')}_${Date.now()}`;
+    const r = await fetch(`${API_BASE}/api/upload-cv-pdf`, {
+      method:'POST', headers:{'Content-Type':'application/json','X-API-Key':apiToken},
+      body: JSON.stringify({
+        pdf_base64: b64,
+        name: name,
+        position: position,
+        email: email,
+        sdt: sdt,
+        nguon: nguon,
+        email_id: emailIdSafe,
+      })
+    });
+    const d = await r.json();
+    if (d.ok || d.action === 'created') {
+      showToast(`✅ Đã thêm "${name}" — AI đang chấm điểm`);
+      closeAddCvModal();
+      setTimeout(() => refreshData(), 1500);
+    } else {
+      showToast('❌ '+(d.error || 'Lỗi thêm CV'));
+    }
+  } catch(e) {
+    showToast('❌ '+e.message);
+  } finally {
+    btn.disabled = false;
+    btn.textContent = '💾 Thêm CV';
+  }
+}
