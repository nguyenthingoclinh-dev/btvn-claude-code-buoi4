+@app.post("/api/admin/upload-cookies")
+@require_api_key
+def upload_cookies():
+    """Upload cookies cho 1 platform (TopCV/JobsGo/VNW...).
+    Body: { platform: 'topcv', cookies: [{name, value, domain, path, ...}], uploaded_by: 'email' }
+    """
+    data = request.get_json(silent=True) or {}
+    platform = (data.get("platform") or "").lower().strip()
+    cookies = data.get("cookies", [])
+    if platform not in VALID_PLATFORMS:
+        return jsonify({"error": f"platform phải là: {VALID_PLATFORMS}"}), 400
+    if not isinstance(cookies, list) or not cookies:
+        return jsonify({"error": "cookies phải là list non-empty"}), 400
+    # Validate cookie shape (each must have name + value)
+    for c in cookies[:5]:  # sample check
+        if not isinstance(c, dict) or "name" not in c or "value" not in c:
+            return jsonify({"error": "Mỗi cookie cần có 'name' và 'value'"}), 400
+    db.save_platform_cookies(platform, cookies, data.get("uploaded_by", ""))
+    return jsonify({"ok": True, "platform": platform, "count": len(cookies)})
+
