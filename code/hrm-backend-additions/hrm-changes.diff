+def _trigger_send_invite(candidate_id: str, force: bool = False) -> None:
+    """Background: gửi invite email + cập nhật status.
+    force=True → bỏ qua check 'đã sent' (dùng khi Sếp đổi Tình trạng từ Không phù hợp ↔ Phù hợp).
+    """
+    try:
+        c = db.get_candidate(candidate_id)
+        if not c:
+            return
+        if not force and c.get("Email mời PV - Trạng thái") == "sent":
+            return
+        ok, info = lark_mail.send_invite_email(c)
+        now = datetime.now().strftime("%d/%m/%Y %H:%M")
+        db.update_candidate_fields(candidate_id, {
+            "email_invite_status": "sent" if ok else "failed",
+            "email_invite_sent_at": now,
+            "email_invite_error": "" if ok else info,
+        })
+        if ok:
+            log.info("Auto-sent invite email cho %s (msg_id=%s, force=%s)", candidate_id, info, force)
+            # Báo Lark IM cho HRM
+            lark_mail.send_lark_im(
+                f"✅ Đã gửi thư mời phỏng vấn\n"
+                f"• Ứng viên: {c.get('Họ tên','?')}\n"
+                f"• Vị trí: {c.get('Vị trí ứng tuyển','?')}\n"
+                f"• Lịch PV: {c.get('Lịch PV','?')}\n"
+                f"• Email: {c.get('Email','?')}"
+            )
+        else:
+            log.warning("Auto-send invite email failed cho %s: %s", candidate_id, info)
+    except Exception:
+        log.exception("_trigger_send_invite exception")
+
+
+def _trigger_send_rejection(candidate_id: str, force: bool = False) -> None:
+    """Background: gửi rejection email + cập nhật status.
+    force=True → bỏ qua check 'đã sent'.
+    """
+    try:
+        c = db.get_candidate(candidate_id)
+        if not c:
+            return
+        if not force and c.get("Email từ chối - Trạng thái") == "sent":
+            return
+        ok, info = lark_mail.send_rejection_email(c)
+        now = datetime.now().strftime("%d/%m/%Y %H:%M")
+        db.update_candidate_fields(candidate_id, {
+            "rejection_email_status": "sent" if ok else "failed",
+            "rejection_email_sent_at": now,
+            "rejection_email_error": "" if ok else info,
+        })
+        if ok:
+            log.info("Auto-sent rejection email cho %s (msg_id=%s, force=%s)", candidate_id, info, force)
+            # Báo Lark IM cho HRM
+            lark_mail.send_lark_im(
+                f"❌ Đã gửi email TỪ CHỐI ứng viên\n"
+                f"• Ứng viên: {c.get('Họ tên','?')}\n"
+                f"• Vị trí: {c.get('Vị trí ứng tuyển','?')}\n"
+                f"• Email: {c.get('Email','?')}\n"
+                f"• Lý do: Tình trạng = Không phù hợp"
+            )
+        else:
+            log.warning("Auto-send rejection email failed cho %s: %s", candidate_id, info)
+    except Exception:
+        log.exception("_trigger_send_rejection exception")
+
