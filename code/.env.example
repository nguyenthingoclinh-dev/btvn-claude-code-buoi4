# ─── Lark App (HR SEONGON Bot) ────────────────────────────────────────────────
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_DOMAIN=https://open.larksuite.com

# ─── Lark User OAuth (HRM nguyenthingoclinh@seongon.com) ─────────────────────
# Lấy bằng cách chạy: python refresh_lark_token.py
# Token sẽ tự rotate sau mỗi lần dùng — code sẽ tự lưu lại file này.
CV_LARK_USER_REFRESH_TOKEN=ur-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Sender email (Lark Mail group) ──────────────────────────────────────────
CV_GMAIL_USER=tuyendung@seongon.com

# ─── Lark IM notify HRM (open_id của Sếp Linh) ───────────────────────────────
CV_NOTIFY_USER_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CV_NOTIFY_EMAIL=nguyenthingoclinh@seongon.com

# ─── HRM REST API (backend trên Cloud Run) ───────────────────────────────────
# Skills (hrm-quet-cv-moi, hrm-loc-ung-vien, hrm-cap-nhat-ung-vien) đọc biến này
# để gọi API. KHÔNG paste plaintext key vào file .md/.py — luôn reference qua env.
HRM_API_KEY=your-hrm-api-key-here
HRM_API_BASE=https://hrm-api-521103150103.asia-southeast1.run.app
